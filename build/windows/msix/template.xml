<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="mintswitch"
        Arguments=""
        InstallLocation="C:\Program Files\MintRouter.AI\MintSwitch">
    </Installer>
    <PackageInformation
        PackageName="MintSwitch"
        PackageDisplayName="MintSwitch By MintRouter.AI"
        PublisherName="CN=MintRouter.AI"
        PublisherDisplayName="MintRouter.AI"
        Version="1.0.0.0"
        PackageDescription="AI Tool API Config Switcher">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dev.mintswitch.app"
                Description="AI Tool API Config Switcher"
                DisplayName="MintSwitch"
                ExecutableName="mintswitch"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>MintSwitch By MintRouter.AI</DisplayName>
            <PublisherDisplayName>MintRouter.AI</PublisherDisplayName>
            <Description>AI Tool API Config Switcher</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="mintswitch.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
